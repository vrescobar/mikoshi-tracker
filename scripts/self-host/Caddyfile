# Site address.
# - Native deployment: set MIKOSHI_TRACKER_SITE_ADDRESS to ":7080" so Caddy
#   binds on a non-privileged port directly on the host.
# - Public HTTPS: set to your real hostname (e.g. "habits.example.com") and
#   Caddy provisions a Let's Encrypt certificate automatically.
#   See docs/PUBLIC-DEPLOYMENT.md.
{$MIKOSHI_TRACKER_SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy {$MIKOSHI_TRACKER_API_UPSTREAM:127.0.0.1:3001}
	}

	handle /health {
		reverse_proxy {$MIKOSHI_TRACKER_API_UPSTREAM:127.0.0.1:3001}
	}

	# Magic-link landing route, served by the API (it consumes the token, sets
	# the session cookie and 303-redirects). The URL shape {base}/magic?t=... is
	# a contract with the Mikoshi WhatsApp bot.
	handle /magic {
		reverse_proxy {$MIKOSHI_TRACKER_API_UPSTREAM:127.0.0.1:3001}
	}

	# Platform webhooks (mikoshi → tracker), e.g. POST /hooks/identity.
	# HMAC-authenticated by the API itself; the public edge must 404 /hooks/*
	# (vhost hardening, mikoshi-stack story 63) — this proxy is private-plane.
	handle /hooks/* {
		reverse_proxy {$MIKOSHI_TRACKER_API_UPSTREAM:127.0.0.1:3001}
	}

	# /admin/* is part of the web SPA now (session-gated operator console);
	# it falls through to the static handler below.

	# Web SPA (Vite build), served statically with index.html fallback so deep
	# links and refreshes work. The relative root resolves against the proxy
	# unit's WorkingDirectory (the repo root). The API sets its own security
	# headers via helmet; these cover static responses.
	handle {
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
		root * apps/web/dist
		try_files {path} /index.html
		file_server
	}
}
