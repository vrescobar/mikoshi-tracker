[Unit]
Description=MikoshiTracker Proxy (Caddy)
After=network.target mikoshi-tracker-api.service mikoshi-tracker-web.service

[Service]
Type=simple
WorkingDirectory=/home/victor/projects/mikoshi-tracker
EnvironmentFile=%h/.config/mikoshi-tracker/env
ExecStart=/home/victor/.local/bin/caddy run --config scripts/self-host/Caddyfile
ExecReload=/home/victor/.local/bin/caddy reload --config scripts/self-host/Caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
