{
  // Canonical OpenClaw-native MikoshiTracker setup.
  // Load the native plugin directly; do not proxy MikoshiTracker through MCP for this host.
  "plugins": {
    "@mikoshi-tracker/openclaw-plugin": {
      "package": "@mikoshi-tracker/openclaw-plugin",
      "env": {
        "MIKOSHI_TRACKER_API_URL": "https://your-mikoshi-tracker.example.com/api",
        "MIKOSHI_TRACKER_API_TOKEN": "${secrets.MIKOSHI_TRACKER_API_TOKEN}",
      },
    },
  },

  // Optional workflow guidance if your OpenClaw build also supports workspace Skills.
  "skills": {
    "entries": {
      "mikoshi-tracker-mcp": "./skills/mikoshi-tracker-mcp/SKILL.md",
    },
  },
}
