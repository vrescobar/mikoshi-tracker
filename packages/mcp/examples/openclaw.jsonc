{
  // OpenClaw workspace-side skill settings. Keep the same env names the MCP runtime expects.
  // If you only have account credentials, run `npx -y @mikoshi-tracker/mcp bootstrap-token` first
  // and store the returned personal API token under the same secret ref used below.
  "skills": {
    "entries": {
      "mikoshi-tracker-mcp": {
        "apiKey": "<same secret as MIKOSHI_TRACKER_API_TOKEN>",
        "env": {
          "MIKOSHI_TRACKER_API_URL": "https://your-mikoshi-tracker.example.com/api",
          "MIKOSHI_TRACKER_API_TOKEN": "<openclaw secret ref or literal personal api token>",
        },
      },
    },
  },

  // Pair OpenClaw with an MCP-capable runner or bridge that actually launches @mikoshi-tracker/mcp.
  // Do not put account passwords here; the runtime still expects MIKOSHI_TRACKER_API_TOKEN only.
  "mcpServers": {
    "mikoshi-tracker": {
      "command": "npx",
      "args": ["-y", "@mikoshi-tracker/mcp"],
      "env": {
        "MIKOSHI_TRACKER_API_URL": "https://your-mikoshi-tracker.example.com/api",
        "MIKOSHI_TRACKER_API_TOKEN": "<same personal api token>",
      },
    },
  },

  // When the paired MCP runner supports prompts/resources, reuse the shipped MikoshiTracker guidance names.
  "guidance": {
    "prompt": "mikoshi_tracker_assistant_workflow",
    "resource": "mikoshi-tracker://guides/workflow",
  },
}
