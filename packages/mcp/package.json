{
  "name": "@mikoshi-tracker/mcp",
  "version": "0.1.6",
  "private": false,
  "description": "Generic stdio MCP server for MikoshiTracker habits, today, and stats APIs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/booooodv/mikoshi-tracker.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/booooodv/mikoshi-tracker/tree/main/packages/mcp",
  "bugs": {
    "url": "https://github.com/booooodv/mikoshi-tracker/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mikoshi-tracker",
    "habits",
    "productivity"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "vitest": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^3.2.4"
  }
}
