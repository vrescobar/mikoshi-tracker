generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  isAdmin           Boolean            @default(false)
  timezone          String             @default("Asia/Shanghai")
  externalId        String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  apiToken          ApiToken?
  magicLinks        MagicLink[]
  circlesOwned      Circle[]           @relation("CircleOwner")
  circleMemberships CircleMembership[]
  leaderboardSnapshots CircleLeaderboardSnapshot[]
  attachments       Attachment[]
  entries           Entry[]
  entryEvents       EntryEvent[]
}

/// One-shot login link issued by /api/admin/issue-magic-link for a provisioned
/// user. `token` stores the SHA-256 hash of the plaintext token that the
/// recipient receives in the URL (same pattern as ApiToken). Consumed at
/// `consumedAt` and never re-usable; expires at `expiresAt` (default 15 min
/// after creation, but the issuer sets this explicitly).
model MagicLink {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  next       String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AppSettings {
  id                  String   @id
  registrationEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ApiToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String   @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@unique([identifier, value])
}

model Attachment {
  id              String         @id @default(cuid())
  eventMutationId String?
  userId          String
  kind            String         @default("image")
  storageKey      String         @unique
  originalName    String?
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  eventMutation   EventMutation? @relation(fields: [eventMutationId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventMutationId, createdAt])
  @@index([userId])
}

model Circle {
  id          String             @id @default(cuid())
  name        String
  ownerId     String
  /// Contest lifecycle. "active" accepts check-ins; "closed" freezes them
  /// (results snapshotted); "archived" hides the contest from default views.
  status      String             @default("active")
  /// Optional contest window. When set, check-ins are rejected outside
  /// [contestStartAt, contestEndAt] and the leaderboard is scored over it.
  contestStartAt DateTime?
  contestEndAt   DateTime?
  /// Free-form season/edition label (e.g. "bikini-2026") used to key snapshots.
  season         String?
  /// "rolling" = live 30d/7d windows (default, legacy parity).
  /// "snapshot" = frozen final standings served from CircleLeaderboardSnapshot.
  leaderboardMode String           @default("rolling")
  /// Contest scoring kind: "habit" (shared-habit completion, default/legacy) or
  /// "metric" (aggregate a payload field of an entry type — kcal/weight/steps).
  contestKind         String  @default("habit")
  /// Metric-contest config (only meaningful when contestKind = "metric").
  metricEntryTypeSlug String?
  metricField         String?
  /// "cumulative" (sum over window), "adherence" (# days meeting target),
  /// "delta" (last logged value − first, e.g. weight change).
  metricMode          String?
  metricTarget        Float?
  /// Whether a higher or lower metric is better — drives ranking direction and
  /// the adherence test (higher → value ≥ target; lower → value ≤ target).
  metricGoal          String? @default("higher")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships CircleMembership[]
  tokens      CircleToken[]
  entryShares CircleEntryShare[]
  leaderboardSnapshots CircleLeaderboardSnapshot[]
}

/// Frozen leaderboard row captured at contest close (`leaderboard/snapshot`).
/// One row per (circle, season, user); `data` holds the full leaderboard entry
/// JSON so the standings survive even if shares/events change afterwards.
model CircleLeaderboardSnapshot {
  id        String   @id @default(cuid())
  circleId  String
  season    String
  userId    String
  rank      Int
  score     Int
  data      String
  createdAt DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, season, userId])
  @@index([circleId, season])
}

model CircleMembership {
  id         String   @id @default(cuid())
  circleId   String
  userId     String
  role       String   @default("member")
  externalId String?
  joinedAt   DateTime @default(now())
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@unique([circleId, externalId])
  @@index([externalId])
}

model CircleToken {
  id        String   @id @default(cuid())
  circleId  String
  token     String   @unique
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId])
}

model EntryType {
  id            String   @id @default(cuid())
  slug          String   @unique
  displayName   String
  cadence       String
  payloadSchema String
  configSchema  String
  aggregations  String
  skillSlug     String?
  isBuiltIn     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  entries       Entry[]

  @@index([isActive])
}

model Entry {
  id           String             @id @default(cuid())
  userId       String
  entryTypeId  String
  name         String
  description  String?
  category     String?
  config       String
  startDate    String
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryType    EntryType          @relation(fields: [entryTypeId], references: [id], onDelete: Restrict)
  weekdays     EntryWeekday[]
  events       EntryEvent[]
  mutations    EventMutation[]
  circleShares CircleEntryShare[]

  @@index([userId, isActive])
  @@index([entryTypeId])
}

model EntryWeekday {
  id      String @id @default(cuid())
  entryId String
  day     String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, day])
  @@index([day])
}

model EntryEvent {
  id          String          @id @default(cuid())
  entryId     String
  userId      String
  occurredAt  DateTime
  dateKey     String
  payload     String
  value       Decimal?
  completed   Boolean?
  // Production: STORED generated column (see migration add_kcal_cached_column).
  // Test databases (via db push): plain nullable column; aggregation engine falls back
  // to json_extract via COALESCE when this is NULL.
  kcalCached  Float?          @map("kcal_cached")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entry       Entry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutations   EventMutation[]

  @@index([entryId, dateKey])
  @@index([entryId, occurredAt])
  @@index([userId, dateKey])
  @@index([dateKey])
  @@index([userId, dateKey, kcalCached])
}

model EventMutation {
  id              String       @id @default(cuid())
  entryId         String
  eventId         String?
  userId          String
  dateKey         String
  type            String
  source          String
  note            String?
  previousPayload String?
  nextPayload     String?
  /// Circle this mutation was made on behalf of, when a circle token (or an AI
  /// acting for a circle) wrote it. Null for personal/web/standalone-AI writes.
  /// Orthogonal to `source`: source = who (actor), this = for which circle (scope).
  onBehalfOfCircleId String?
  createdAt       DateTime     @default(now())
  entry           Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  event           EntryEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  attachments     Attachment[]

  @@index([entryId, dateKey, createdAt])
  @@index([eventId, createdAt])
  @@index([onBehalfOfCircleId])
}

model CircleEntryShare {
  id        String   @id @default(cuid())
  circleId  String
  entryId   String
  createdAt DateTime @default(now())
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([circleId, entryId])
  @@index([entryId])
}

/// A named admin credential. Lets god-mode be operated by several people/bots
/// with per-operator identity (vs the single static MIKOSHI_TRACKER_ADMIN_API_KEY,
/// which remains the root credential that bootstraps these). `token` is a SHA-256
/// hash; the plaintext (mikoshi_tracker_admin_*) is shown once at creation.
model AdminToken {
  id         String    @id @default(cuid())
  token      String    @unique
  label      String
  revoked    Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([revoked])
}

/// Append-only audit trail of admin (god-mode) actions, so "who did what" is
/// answerable. `actorType` is "env" (static key), "token" (named AdminToken),
/// or "session" (signed-in user with the isAdmin flag);
/// `metadata` is an optional JSON string of action-specific detail.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  actorLabel String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
