APP_BASE_URL=http://localhost:8080
# Generate a real secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters-long

# Optional overrides
# MIKOSHI_TRACKER_PUBLIC_PORT=8080
# DATABASE_URL=file:/data/mikoshi-tracker.db
# API_INTERNAL_BASE_URL=http://api:3001
# BETTER_AUTH_URL=http://localhost:8080
# CORS_ORIGIN=http://localhost:8080
# Directory where uploaded attachment images are stored (on the data volume).
# ATTACHMENTS_DIR=/data/attachments

# External provisioning API (Phase 11 / Mikoshi integration).
# Set to a long random secret to enable the /api/admin/* provisioning routes.
# When unset, those routes return 503 (feature disabled). Generate with:
#   openssl rand -hex 32
# MIKOSHI_TRACKER_ADMIN_API_KEY=replace-with-a-long-random-secret

# Public HTTPS deployment: set this to your real hostname so the Caddy proxy
# provisions a Let's Encrypt TLS certificate automatically. Also publish port
# 443 and uncomment the proxy `environment` block in docker-compose.yml.
# See docs/PUBLIC-DEPLOYMENT.md.
# MIKOSHI_TRACKER_SITE_ADDRESS=habits.example.com
