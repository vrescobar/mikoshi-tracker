APP_BASE_URL=http://localhost:7080
# Generate a real secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters-long

# Optional overrides
# MIKOSHI_TRACKER_PUBLIC_PORT=7080
# DATABASE_URL=file:~/.local/share/mikoshi-tracker/mikoshi-tracker.db
# API_INTERNAL_BASE_URL=http://127.0.0.1:3001
# BETTER_AUTH_URL=http://localhost:7080
# Comma-separated allowlist for cross-origin API access.
# CORS_ORIGIN=http://localhost:7080
# Directory where uploaded attachment images are stored.
# ATTACHMENTS_DIR=~/.local/share/mikoshi-tracker/attachments

# External provisioning API (Phase 11 / Mikoshi integration).
# Set to a long random secret to enable the /api/admin/* provisioning routes.
# When unset, those routes return 503 (feature disabled). Generate with:
#   openssl rand -hex 32
# MIKOSHI_TRACKER_ADMIN_API_KEY=replace-with-a-long-random-secret

# Public HTTPS deployment: set this to your real hostname so the Caddy proxy
# provisions a Let's Encrypt TLS certificate automatically (Caddy must be able
# to bind ports 80/443). See docs/PUBLIC-DEPLOYMENT.md.
# MIKOSHI_TRACKER_SITE_ADDRESS=habits.example.com
