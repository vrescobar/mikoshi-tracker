# NOTE: Production runs on Fly.io (https://mikoshi-tracker.fly.dev) — its env is
# defined in fly.toml + `fly secrets`, NOT this file. This .env is for LOCAL dev
# only (`bun dev`); the systemd self-host (scripts/self-host) is the legacy path.
# See docs/PUBLIC-DEPLOYMENT.md → "Official deployment: Fly.io".
APP_BASE_URL=http://localhost:7080
# Generate a real secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters-long

# Optional overrides
# MIKOSHI_TRACKER_PUBLIC_PORT=7080
# DATABASE_URL=file:~/.local/share/mikoshi-tracker/mikoshi-tracker.db
# API_INTERNAL_BASE_URL=http://127.0.0.1:3001
# BETTER_AUTH_URL=http://localhost:7080
# Comma-separated allowlist for cross-origin API access.
# CORS_ORIGIN=http://localhost:7080
# Directory where uploaded attachment images are stored.
# ATTACHMENTS_DIR=~/.local/share/mikoshi-tracker/attachments

# External provisioning API (Phase 11 / Mikoshi integration).
# Set to a long random secret to enable the /api/admin/* provisioning routes.
# When unset, those routes return 503 (feature disabled). Generate with:
#   openssl rand -hex 32
# MIKOSHI_TRACKER_ADMIN_API_KEY=replace-with-a-long-random-secret

# Port the single Bun process listens on (it serves both the API and the built
# Vite SPA — there is no reverse proxy). Defaults to 3001 in dev / 7080 in the
# systemd unit.
# PORT=7080
#
# Public HTTPS deployment: terminate TLS in front of PORT (Tailscale Serve, a
# Caddy/nginx you already run, etc.). See docs/PUBLIC-DEPLOYMENT.md.

# ── Fast remote dev (e.g. a Tailscale-connected MacBook at 100.71.187.4) ──────
# Run `bun dev` (Vite :3000 binds 0.0.0.0 and proxies /api + /magic → :3001).
# The magic-link host == BETTER_AUTH_URL and MUST be inside CORS_ORIGIN, so set
# both to the address you open in the browser — then WhatsApp magic links issued
# by the kernel are clickable from your phone over Tailscale.
#   BETTER_AUTH_URL=http://100.71.187.4:3000
#   CORS_ORIGIN=http://100.71.187.4:3000,http://localhost:3000
# The Mikoshi kernel does NOT run here; reach it only as an API on the Jetson:
#   MIKOSHI_PLATFORM_API_URL=http://jetson:7777/api/platform/v1
